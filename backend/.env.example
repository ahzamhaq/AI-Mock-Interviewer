PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai-mock-interviewer

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# Primary AI Provider (gemini | groq | openrouter)
# Multi-provider fallback chain is automatic: if primary returns 429/quota/404,
# the AIProviderManager tries the others in order.
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Groq (https://console.groq.com) — extremely fast llama 3.1 inference, free tier
GROQ_API_KEY=

# OpenRouter (https://openrouter.ai) — last-resort fallback, free models available
OPENROUTER_API_KEY=

# Anti-repetition similarity threshold (0..1). Higher = stricter dedup. Default 0.78.
SIMILARITY_THRESHOLD=0.78

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads/

# TTS (optional — falls back to browser SpeechSynthesis when unset)
# TTS_PROVIDER=elevenlabs   to enable server-side ElevenLabs TTS
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google OAuth (frontend uses VITE_GOOGLE_CLIENT_ID; backend verifies tokens with this)
GOOGLE_CLIENT_ID=your-google-oauth-client-id

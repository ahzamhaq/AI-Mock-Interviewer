PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai-mock-interviewer

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# Primary AI Provider (gemini | groq | openrouter)
# Multi-provider fallback chain is automatic: if primary returns 429/quota/404,
# the AIProviderManager tries the others in order.
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Groq (https://console.groq.com) — extremely fast llama 3.1 inference, free tier
GROQ_API_KEY=

# OpenRouter (https://openrouter.ai) — last-resort fallback, free models available
OPENROUTER_API_KEY=

# Anti-repetition similarity threshold (0..1). Higher = stricter dedup. Default 0.78.
SIMILARITY_THRESHOLD=0.78

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads/

# TTS (optional — falls back to browser SpeechSynthesis when unset)
# TTS_PROVIDER=elevenlabs   to enable server-side ElevenLabs TTS
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google OAuth (frontend uses VITE_GOOGLE_CLIENT_ID; backend verifies tokens with this)
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Judge0 (required for DSA code execution — /run and /submit). Self-hosted
# (docker: judge0/judge0) or RapidAPI-hosted. Without JUDGE0_URL, code
# execution returns a clean "not configured" error instead of crashing.
JUDGE0_URL=
JUDGE0_API_KEY=

# GitHub OAuth (optional — account linking only, for private repo import.
# Never required for core app use.)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5000/api/integrations/github/callback
# 64-hex-char (32-byte) key for AES-256-GCM encryption of stored GitHub tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_ENCRYPTION_KEY=

# Comma-separated emails treated as demo/reset-eligible accounts (optional,
# defaults to demo@interviewai.com).
DEMO_EMAILS=demo@interviewai.com
